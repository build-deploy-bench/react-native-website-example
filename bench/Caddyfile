# Serves the Docusaurus build on Railway and Fly, which have no static hosting product.
{
	admin off
}

:{$PORT} {
	# /version comes from the runtime env, so a new BENCH_RUN_ID identifies the deployment without a rebuild.
	handle /version {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"commit":"{env.BENCH_COMMIT}","run":"{env.BENCH_RUN_ID}","deployment":"{env.RAILWAY_DEPLOYMENT_ID}"}` 200
	}
	handle {
		root * /srv
		# Docusaurus writes /docs/foo as docs/foo.html (trailingSlash: false).
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
