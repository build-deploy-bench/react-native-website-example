{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "sh bench/build.sh install",
  "buildCommand": "sh bench/build.sh build",
  "outputDirectory": "website/build",
  "rewrites": [{ "source": "/version", "destination": "/version.json" }],
  "headers": [{ "source": "/version", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }],
  "git": { "deploymentEnabled": false }
}
